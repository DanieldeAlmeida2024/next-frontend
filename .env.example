# Backend NestJS acessado somente pelo servidor Next.js:
NEST_API_URL=http://127.0.0.1:3001
# Backend Socket.IO acessado pelo navegador (requer CORS configurado no backend):
NEXT_PUBLIC_NEST_API_URL=http://127.0.0.1:3001
# Endpoint HTTP do próprio frontend para consultas client-side:
NEXT_PUBLIC_NEXT_API_URL=http://127.0.0.1:3000/api
# Chave pública Google Maps JS: restringir por HTTP referrer e APIs permitidas.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Credencial de integração servidor-servidor (não use prefixo NEXT_PUBLIC_).
# Mesmo valor de ROUTES_API_KEY configurado no NestJS; mínimo de 32 caracteres.
ROUTES_API_KEY=
# Ative somente em bancada local isolada: não existe login por usuário neste frontend.
ALLOW_UNAUTHENTICATED_ROUTE_DEMO=false
